# reelscribe HTTP ingestion endpoint (systemd *user* service).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp scripts/reelscribe-serve.service ~/.config/systemd/user/
#   # serve.env (mode 600) must contain REELSCRIBE_TOKEN and
#   # REELSCRIBE_DATABASE_URL; this setup keeps the data root under the repo:
#   #   REELSCRIBE_TOKEN=...
#   #   REELSCRIBE_DATABASE_URL=postgresql://instagram_recap:...@127.0.0.1:5433/homelab
#   #   REELSCRIBE_HOME=%h/Homelab/Instagram-recap/data
#   #   REELSCRIBE_MODEL=medium            # optional
#   loginctl enable-linger "$USER"         # run without an active login session
#   systemctl --user daemon-reload
#   systemctl --user enable --now reelscribe-serve
#   systemctl --user status reelscribe-serve
#
# If your data root is elsewhere, change EnvironmentFile= below and set
# REELSCRIBE_HOME inside that file.
#
# Logs:  journalctl --user -u reelscribe-serve -f

[Unit]
Description=reelscribe HTTP ingestion endpoint
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/Homelab/Instagram-recap/data/serve.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/reelscribe serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
